rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User accounts
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Core patient records
    match /pasien/{pasienId} {
      allow read, write: if true;
    }
    
    // Hospital visits and queues
    match /kunjungan/{kunjunganId} {
      allow read, write: if true;
    }
    
    // Medical personnel
    match /dokter/{dokterId} {
      allow read, write: if true;
    }
    
    match /perawat/{perawatId} {
      allow read, write: if true;
    }
    
    // Hospital global configuration
    match /hospital_settings/{settingId} {
      allow read, write: if true;
    }
    
    // Synchronized module storage
    match /system_data/{dataId} {
      allow read, write: if true;
    }

    // Real-time security and activity audit logs
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Health check validation
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
