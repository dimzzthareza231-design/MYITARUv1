rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny for unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User accounts and profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Patients master collection
    match /pasien/{pasienId} {
      allow read, write: if true;
    }

    // Visits and queue encounters
    match /kunjungan/{kunjunganId} {
      allow read, write: if true;
    }

    // Master doctors
    match /dokter/{dokterId} {
      allow read, write: if true;
    }

    // Master nurses
    match /perawat/{perawatId} {
      allow read, write: if true;
    }

    // Hospital configuration
    match /hospital_settings/{docId} {
      allow read, write: if true;
    }

    // Real-time system data & clinical module persistence
    match /system_data/{docId} {
      allow read, write: if true;
    }
  }
}

