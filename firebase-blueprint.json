{
  "entities": {
    "User": {
      "title": "User",
      "description": "Hospital staff and user profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "nama": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "roleId": { "type": "string" },
        "aktif": { "type": "boolean" },
        "dibuatPada": { "type": "string" },
        "isGoogleAuth": { "type": "boolean" }
      },
      "required": ["nama", "roleId"]
    },
    "Pasien": {
      "title": "Pasien",
      "description": "Hospital patient demographic and medical records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no_rm": { "type": "string" },
        "nik": { "type": "string" },
        "nama": { "type": "string" },
        "tanggal_lahir": { "type": "string" },
        "jenis_kelamin": { "type": "string" },
        "alamat": { "type": "string" },
        "penjamin": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["nama", "no_rm"]
    },
    "Kunjungan": {
      "title": "Kunjungan",
      "description": "Outpatient, inpatient, and emergency patient visits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pasien_id": { "type": "string" },
        "tanggal": { "type": "string" },
        "poli_id": { "type": "string" },
        "dokter_id": { "type": "string" },
        "status": { "type": "string" },
        "tipe": { "type": "string" },
        "nomor_antrian": { "type": "string" }
      },
      "required": ["pasien_id", "tanggal", "status"]
    },
    "Dokter": {
      "title": "Dokter",
      "description": "Medical doctors and specialists master data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" },
        "spesialisasi": { "type": "string" }
      },
      "required": ["nama"]
    },
    "Perawat": {
      "title": "Perawat",
      "description": "Nurses master data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" }
      },
      "required": ["nama"]
    },
    "HospitalSettings": {
      "title": "HospitalSettings",
      "description": "Hospital general metadata and settings",
      "type": "object",
      "properties": {
        "nama": { "type": "string" },
        "alamat": { "type": "string" }
      },
      "required": ["nama"]
    },
    "SystemData": {
      "title": "SystemData",
      "description": "Module state persistence",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "data": { "type": "string" }
      },
      "required": ["key"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Security audit logs for Firebase authentication and database access attempts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "status": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "details": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["category", "action", "status", "timestamp"]
    }
  },
  "firestore": {
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Real-time security and database activity logs"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/pasien/{pasienId}": {
      "schema": "Pasien",
      "description": "Patient records"
    },
    "/kunjungan/{kunjunganId}": {
      "schema": "Kunjungan",
      "description": "Encounter records"
    },
    "/dokter/{dokterId}": {
      "schema": "Dokter",
      "description": "Doctor master records"
    },
    "/perawat/{perawatId}": {
      "schema": "Perawat",
      "description": "Nurse master records"
    },
    "/hospital_settings/{settingId}": {
      "schema": "HospitalSettings",
      "description": "Hospital configuration"
    },
    "/system_data/{dataId}": {
      "schema": "SystemData",
      "description": "Generic persistent module documents"
    },
    "/test/{docId}": {
      "schema": "SystemData",
      "description": "Health check and connection validation document"
    }
  }
}
